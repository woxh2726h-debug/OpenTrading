{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opentrading",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  // Required for Telegram notifications and the optional server watchlist.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "opentrading",
      "database_id": "30359616-f63c-4bc5-b0f8-36fb9fe891be"
    }
  ]

  // --- Optional: persistent watchlist -------------------------------------
  // Tables are created by the Worker on first use, no migrations needed.
}
