{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opentrading",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  }

  // --- Optional: persistent watchlist -------------------------------------
  // 1. npx wrangler d1 create opentrading
  // 2. Copy the returned database_id below and uncomment the block.
  // 3. npx wrangler d1 execute opentrading --remote --file=./schema.sql
  //
  // Without D1 the app stores the watchlist in localStorage instead.
  //
  // "d1_databases": [
  //   {
  //     "binding": "DB",
  //     "database_name": "opentrading",
  //     "database_id": "00000000-0000-0000-0000-000000000000"
  //   }
  // ]
}
